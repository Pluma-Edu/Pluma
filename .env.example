# Postgres. The item bank is the cache, so this is the only store that matters.
DATABASE_URL=postgresql://pluma:pluma@127.0.0.1:5432/pluma_dev

# Chromium for the print renderer. Set explicitly rather than relying on a
# version-matched playwright download.
CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# Model generation. Absent = the model path refuses to run; the template path
# is unaffected and needs no credentials.
# ANTHROPIC_API_KEY=
